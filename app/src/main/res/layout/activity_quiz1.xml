<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".dynamicQuestions.QuizActivity"
    android:background="@drawable/backgroud4">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="20dp" />

    <!-- Header avec numéro de question dynamique -->
    <TextView
        android:id="@+id/questionNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:gravity="center"
        android:text="Question 1/5"
        android:textSize="30sp"
        android:layout_marginTop="20dp"
        android:textStyle="bold"
        android:textColor="@color/linksColor" />

    <!-- Timer en haut -->
    <TextView
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="00:12"
        android:textColor="#FF0000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="@drawable/timer_background"
        android:padding="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Image de la question (dynamique) -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:src="@drawable/imageq1"
                android:contentDescription="Image de la question" />

            <!-- Texte de la question (dynamique) -->
            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Quelle est la planète la plus proche du Soleil ?"
                android:textColor="@color/linksColor"
                android:textSize="24sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <!-- RadioGroup pour les options (dynamique) -->
            <RadioGroup
                android:id="@+id/rg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp">

                <!-- Les RadioButtons seront créés dynamiquement -->
                <!-- Ceci est juste un exemple pour le design -->
                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:buttonTint="@color/colorPrimary"
                    android:text="Option exemple"
                    android:textSize="18sp"
                    android:padding="12dp"
                    android:background="@drawable/radio_button_background"
                    android:visibility="gone" />

            </RadioGroup>

            <!-- Bouton Suivant/Terminer -->
            <Button
                android:id="@+id/button2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/colorPrimaryDark"
                android:text="Suivant"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:elevation="4dp" />

            <!-- Indicateur de progression (optionnel) -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:max="5"
                android:progress="1"
                android:progressTint="@color/colorPrimary"
                android:progressBackgroundTint="@color/colorPrimaryLight" />

            <!-- Étoile décorative -->
            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="20dp"
                app:srcCompat="@android:drawable/btn_star_big_on"
                android:contentDescription="Étoile décorative" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>